    "data:backfill-categories": "tsx scripts/backfill_category_hierarchy.ts",
    "data:backfill-stock": "tsx scripts/backfill_listing_stock.ts",
    "data:import": "tsx scripts/import_seed_1200.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:category-integration": "tsx scripts/verify_category_integration.ts",
    "test:category-legacy": "tsx scripts/verify_category_legacy_integration.ts",
