BOOKVERSE_BIND_ADDRESS="127.0.0.1"
BOOKVERSE_POSTGRES_PORT="5432"
BOOKVERSE_WEB_PORT="3000"
BOOKVERSE_AI_PORT="8000"
ALLOWED_DESTRUCTIVE_DATABASES="bookverse_ai_test"
CATEGORY_LEGACY_DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/bookverse_ai?schema=public"
DEMO_DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/bookverse_ai?schema=public"
STOCK_INTEGRATION_DATABASE="bookverse_ai_test"
