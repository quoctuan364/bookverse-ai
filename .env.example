BOOKVERSE_LOCAL_POSTGRES_PORT="5432"
BOOKVERSE_LOCAL_WEB_PORT="3000"
BOOKVERSE_LOCAL_AI_PORT="8000"

# Test Compose: database, volume, project name và port tách khỏi local/production.
BOOKVERSE_TEST_POSTGRES_USER="bookverse_test"
BOOKVERSE_TEST_POSTGRES_PASSWORD="replace-with-a-long-random-test-password"
BOOKVERSE_TEST_POSTGRES_DB="bookverse_ai_test"
