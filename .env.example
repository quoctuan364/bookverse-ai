AUTH_SECRET="replace-with-at-least-32-random-bytes"
AUTH_TRUST_HOST="true"
# Google OAuth (tùy chọn). Không commit Client Secret thật.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Chỉ hiện nút điền nhanh tài khoản demo khi chạy development.
BOOKVERSE_SHOW_DEMO_ACCOUNTS="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production: webhook HTTPS nội bộ chịu trách nhiệm gửi email reset; không log token.
BOOKVERSE_PASSWORD_RESET_WEBHOOK_URL=""
BOOKVERSE_PASSWORD_RESET_WEBHOOK_TOKEN=""
AI_SERVICE_URL="http://127.0.0.1:8000"
BOOKVERSE_AI_SERVICE_TOKEN=""
BOOKVERSE_AI_ALLOWED_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"
RECOMMENDATION_ATTRIBUTION_WINDOW_DAYS="7"
# Chỉ bật trong môi trường pilot riêng sau khi người tham gia đã đồng thuận.
RECOMMENDATION_PILOT_MODE="off"
RECOMMENDATION_PILOT_ID=""
RECOMMENDATION_CONSENT_VERSION=""
RECOMMENDATION_EXPERIMENT_GROUP=""
# Chỉ đặt cục bộ khi export; tối thiểu 32 ký tự và không commit.
BOOKVERSE_EXPORT_HMAC_KEY=""
BOOKVERSE_LLM_PROVIDER="openai"
BOOKVERSE_CHAT_MOCK_ENABLED="false"
BOOKVERSE_CHAT_TIMEOUT_MS="8000"
BOOKVERSE_ASSISTANT_LEGACY_UI="false"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
BOOKVERSE_EMBEDDING_PROVIDER="openai"

# Local Compose: chỉ điền trong .env local, không commit giá trị thật.
BOOKVERSE_LOCAL_POSTGRES_USER="bookverse_local"
BOOKVERSE_LOCAL_POSTGRES_PASSWORD="replace-with-a-long-random-local-password"
BOOKVERSE_LOCAL_POSTGRES_DB="bookverse_ai_local"
BOOKVERSE_LOCAL_DOCKER_DATABASE_URL="postgresql://bookverse_local:REPLACE_ME@db:5432/bookverse_ai_local?schema=public"
